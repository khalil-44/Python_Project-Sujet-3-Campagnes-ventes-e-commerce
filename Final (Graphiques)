import pandas as pd
import matplotlib.pyplot as plt

# Charger les données
df = pd.read_excel("data.xlsx")
df["InvoiceDate"] = pd.to_datetime(df["InvoiceDate"])
df = df.dropna(subset=["CustomerID"])
df["Revenue"] = df["Quantity"] * df["UnitPrice"]
df["Month"] = df["InvoiceDate"].dt.to_period("M")

# 1. Barres du CA par pays (Top 10)
top10 = df.groupby("Country")["Revenue"].sum().sort_values(ascending=False).head(10)
top10.plot(kind="bar", title="Top 10 CA par pays")
plt.show()

# 2. Courbe du CA par mois
monthly = df.groupby("Month")["Revenue"].sum()
monthly.plot(kind="line", marker="o", title="CA par mois")
plt.show()

# 3. Histogramme des montants de commande
df["Revenue"].plot(kind="hist", bins=50, title="Histogramme des montants")
plt.show()

# 4. Boxplot des paniers par pays
df.boxplot(column="Revenue", by="Country")
plt.title("Boxplot des paniers par pays")
plt.suptitle("")
plt.show()

# Export Top 10
top10.to_excel("top10_countries.xlsx", index=False)
print("✅ Exporté vers top10_countries.xlsx")

